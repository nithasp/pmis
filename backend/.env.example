# Copy to .env and fill in. The server refuses to start when a required value is missing or too
# short, so nothing silently falls back to an insecure default.

# Environment: dev | production. NODE_ENV=production (the Docker image sets it) also means production.
# Outside production the API returns e-mail links and codes in its responses, so the flows can be
# tested without a mail server.
ENV=dev

# Database: set DATABASE_URL (managed provider) or the POSTGRES_* values (local Docker, port 5435)
# DATABASE_URL=postgresql://user:password@host:5432/database
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5435
POSTGRES_DB=pmis_dev
POSTGRES_USER=pmis_user
POSTGRES_PASSWORD=pmis_pass

# TLS to the database: off (local) | verify | no-verify
DATABASE_SSL=off
# DATABASE_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# Passwords: PASSWORD_PEPPER is required and must be at least 32 characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
PASSWORD_PEPPER=
SALT_ROUNDS=10

# JWT: TOKEN_SECRET is required and must be at least 32 characters (generate it the same way).
# The frontend keeps access_token + refresh_token in localStorage and calls POST /auth/refresh
# with the refresh token when the access token has expired.
TOKEN_SECRET=
ACCESS_TOKEN_EXPIRY=1h
REFRESH_TOKEN_EXPIRY_DAYS=7

# Server
PORT=4100
# Comma-separated list of browser origins allowed to call the API (the Nuxt dev server is 3000)
ALLOWED_ORIGIN=http://localhost:3000
# Public base URL of this API (file URLs, e-mail links, Altair endpoint)
PUBLIC_URL=http://localhost:4100
# Public URL of the web app (links inside the e-mails the API "sends")
FRONTEND_URL=http://localhost:3000
TRUST_PROXY=1
LOG_LEVEL=info

# Limits (optional)
API_RATE_LIMIT=1000
AUTH_RATE_LIMIT=60
JSON_BODY_LIMIT=5mb
UPLOAD_MAX_MB=20

# Days an activity-log row is kept before the daily cleanup deletes it (optional)
ACTIVITY_LOG_RETENTION_DAYS=180

# Accounts created by `npm run seed`. In production the seed refuses this published password and
# gives the mock officer and agency accounts random ones.
ADMIN_EMAIL=admin@pmis.local
ADMIN_PASSWORD=Admin@12345678

# Demo entry: POST /auth/demo signs a visitor in as this shared SuperAdmin-level account so the
# site can be viewed without a login. `npm run seed` creates it. DEMO_READ_ONLY=true rejects every
# write (POST/PUT/DELETE) made with a demo session while still letting the visitor browse everything.
# When it is not set, it is true in production and false otherwise.
DEMO_LOGIN_ENABLED=true
DEMO_EMAIL=demo@pmis.local
DEMO_PASSWORD=Demo@12345678
# DEMO_READ_ONLY=false

# E-mail: log (prints the link, default) | smtp (fill the SMTP_* values)
MAIL_DRIVER=log
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=PMIS <no-reply@pmis.local>

# GraphQL tooling: schema introspection and the bundled Altair explorer at /altair
GRAPHQL_INTROSPECTION=true
ALTAIR_ENABLED=true

# File storage: local (saves under ./uploads, served at /uploads) | r2 (Cloudflare R2 Object Storage)
STORAGE_DRIVER=local

# Cloudflare R2 Object Storage (needed when STORAGE_DRIVER=r2) -------------------------------------
# Dashboard -> R2 -> Manage R2 API Tokens. The S3 endpoint is https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCOUNT_ID=b22221d8a3dce1f7aa20eaeadfb63c7f
R2_ACCESS_KEY_ID=e64b7ec369d962749d560a88e5a41f80
R2_SECRET_ACCESS_KEY=21f51c2b4771dc1776c5108aa7c500c6d1473c3ee20a2ce1156e3d8622b41b3b
R2_BUCKET=pmis-files
# Public bucket URL or custom domain (e.g. https://pub-xxxx.r2.dev or https://files.example.com).
# Leave empty to serve files through short-lived presigned URLs instead.
R2_PUBLIC_URL=https://pub-8355a9f5a61a452f94559ca3ae3050ea.r2.dev
# Optional key prefix inside the bucket
R2_KEY_PREFIX=pmis
