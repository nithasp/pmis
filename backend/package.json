{
  "name": "pmis-backend",
  "version": "1.0.0",
  "description": "REST + GraphQL backend for the Port Management Information System (PMIS) upgrade",
  "main": "dist/server.js",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --enable-source-maps dist/server.js",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "dev": "tsx watch src/server.ts",
    "watch": "tsc-watch -p tsconfig.build.json --onSuccess \"node --enable-source-maps ./dist/server.js\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "migrate:up": "db-migrate --config database.js up",
    "migrate:down": "db-migrate --config database.js down",
    "migrate:reset": "db-migrate --config database.js reset",
    "migrate:prod": "db-migrate --config database.js --env production up",
    "seed": "tsx src/scripts/seed.ts",
    "seed:prod": "node --enable-source-maps dist/scripts/seed.js",
    "setup": "npm run migrate:up && npm run seed",
    "release": "npm run migrate:prod && npm run seed:prod"
  },
  "keywords": [
    "api",
    "express",
    "graphql",
    "postgresql",
    "jwt",
    "pmis"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@graphql-tools/schema": "^10.0.0",
    "altair-static": "^8.5.9",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "db-migrate": "^0.11.14",
    "db-migrate-pg": "^1.5.2",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.0",
    "graphql": "^16.9.0",
    "graphql-http": "^1.22.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.0",
    "pdfkit": "^0.15.0",
    "pg": "^8.13.0",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.10.0",
    "@types/pdfkit": "^0.13.5",
    "@types/pg": "^8.11.10",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^10.0.0",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.4.0",
    "tsc-watch": "^6.2.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.15.0"
  }
}
