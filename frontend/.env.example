# Copy to .env (npm run dev / npm run generate) or to .env.prd (npm run generate:prd).
# Everything here is PUBLIC: `nuxt generate` writes these values into the files every visitor
# downloads, so never put a secret in this file.

# Base URL of the PMIS API in ../backend, including /api/v1. `npm run dev` falls back to the local
# backend when it is not set; `nuxt generate` refuses to run without it.
NUXT_PUBLIC_API_BASE_URL=http://localhost:4100/api/v1

# Label shown on the login page, in the sidebar and under Settings > General
NUXT_PUBLIC_VERSION=DEV: 1.16.2
